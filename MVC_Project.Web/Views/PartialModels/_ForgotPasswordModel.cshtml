<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <!-- Header -->
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <form id="forgotPasswordForm">
                <div class="modal-body px-4 pt-2">

                    <!-- Centered Icon + Header -->
                    <div class="text-center mb-4">

                        <div class="d-inline-flex align-items-center justify-content-center
                        bg-primary bg-opacity-10 rounded-circle mb-3"
                             style="width: 80px; height: 80px;">
                            <i class="bi bi-shield-lock-fill text-primary fs-2"></i>
                        </div>

                        <h4 class="fw-semibold mb-2">Forgot Password</h4>

                        <p class="text-muted small px-3 mb-4">
                            Enter your registered email address.
                            We’ll send you a secure password reset link.
                        </p>

                    </div>

                    <!-- Message -->
                    <div id="forgotPasswordMessage" class="alert d-none small"></div>

                    <!-- Input -->
                    <div class="mb-4">
                        <label class="form-label fw-medium">Email Address</label>
                        <input type="email"
                               name="email"
                               id="forgotPasswordEmail"
                               class="form-control form-control-lg rounded-3"
                               placeholder="e.g. user@example.com"
                               required />
                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 pt-0 px-4">
                    <button type="button"
                            class="btn btn-light px-4"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit"
                            class="btn btn-primary px-4"
                            id="sendResetBtn">
                        <i class="bi bi-envelope-check me-1"></i>
                        Send Reset Link
                    </button>
                </div>
            </form>


        </div>
    </div>
</div>
<script>
    document.getElementById("forgotPasswordForm")
        .addEventListener("submit", function (e) {

            e.preventDefault();

            let email = document.getElementById("forgotPasswordEmail").value;
            let messageBox = document.getElementById("forgotPasswordMessage");
            let btn = document.getElementById("sendResetBtn");

            btn.disabled = true;

            fetch('/Account/ForgotPassword', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: 'email=' + encodeURIComponent(email)
            })
            .then(res => res.json())
            .then(data => {
                messageBox.classList.remove("d-none");

                if (data.success) {
                    messageBox.className = "alert alert-success";
                       messageBox.innerHTML = `${data.message}
                                       <strong class="text-primary ms-1">${data.email}</strong>.`;
                } else {
                    messageBox.className = "alert alert-danger";
                    messageBox.innerText = data.message;
                }

                btn.disabled = false;
            });
        });

          //Script perform tasks for Clear button

    
       const forgotPasswordModal = document.getElementById('forgotPasswordModal');

       forgotPasswordModal.addEventListener('hidden.bs.modal', function () {

           // 1️⃣ Reset form fields
           const form = document.getElementById("forgotPasswordForm");
           if (form) form.reset();

           // 2️⃣ Clear message box
           const messageBox = document.getElementById("forgotPasswordMessage");
           if (messageBox) {
               messageBox.className = "alert d-none";
               messageBox.innerHTML = "";
           }

           // 3️⃣ Re-enable submit button
           const btn = document.getElementById("sendResetBtn");
           if (btn) btn.disabled = false;

           // 4️⃣ Move focus OUT of modal (Accessibility fix)
           const triggerBtn = document.querySelector('[data-bs-target="#forgotPasswordModal"]');
           if (triggerBtn) {
               triggerBtn.focus();
           }
       });


</script>
