@model MVC_Project.Models.Models.Salaries
@{
    ViewData["Title"] = "Edit Salary";
}

<div class="salary-header">
    <h1><i class="bi bi-pencil-square me-2"></i>Edit Salary Record</h1>
    <p class="mb-0 mt-2 opacity-75">Update salary information for the employee</p>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="salary-form-card">
            <form asp-action="Edit" method="post" novalidate>
                <input type="hidden" asp-for="Id" />

                <!-- Employee Section -->
                <div class="form-section">
                    <h5 class="form-section-title">
                        <i class="bi bi-person-circle me-2"></i>Employee Information
                    </h5>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-person me-2"></i>Employee <span class="text-danger">*</span>
                        </label>
                        @{
                            var _items = new SelectList(ViewBag.Employees, "EmployeeCode", "Name", Model.EmployeeCode);
                        }
                        <select asp-for="EmployeeCode" class="form-select" asp-items="@(_items)" required>
                        </select>
                        <span asp-validation-for="EmployeeCode" class="text-danger small mt-2 d-block"></span>
                    </div>
                </div>

                <!-- Salary Components -->
                <div class="form-section">
                    <h5 class="form-section-title">
                        <i class="bi bi-calculator me-2"></i>Salary Components
                    </h5>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-cash me-2"></i>Base Salary <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="BaseSalary" class="form-control" type="number" step="0.01" required>
                                </div>
                                <span asp-validation-for="BaseSalary" class="text-danger small mt-2 d-block"></span>
                                <small class="text-muted">Core monthly salary amount</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-gift me-2"></i>Bonus
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="Bonus" class="form-control" type="number" step="0.01">
                                </div>
                                <span asp-validation-for="Bonus" class="text-danger small mt-2 d-block"></span>
                                <small class="text-muted">Additional bonus/incentive</small>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-dash-circle me-2"></i>Deductions
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="Deductions" class="form-control" type="number" step="0.01">
                        </div>
                        <span asp-validation-for="Deductions" class="text-danger small mt-2 d-block"></span>
                        <small class="text-muted">Tax, insurance, and other deductions</small>
                    </div>
                </div>

                <!-- Summary Display -->
                <div class="salary-summary-card">
                    <h6 class="summary-title">
                        <i class="bi bi-calculator me-2"></i>Salary Summary
                    </h6>
                    <div class="summary-row">
                        <span>Base Salary:</span>
                        <span id="summaryBase" class="summary-value">₹0.00</span>
                    </div>
                    <div class="summary-row">
                        <span>Bonus:</span>
                        <span id="summaryBonus" class="summary-value text-success">+₹0.00</span>
                    </div>
                    <div class="summary-row">
                        <span>Deductions:</span>
                        <span id="summaryDeductions" class="summary-value text-warning">-₹0.00</span>
                    </div>
                    <div class="summary-row summary-total">
                        <span>Net Salary:</span>
                        <span id="summaryNet" class="summary-value">₹0.00</span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="button-group">
                    <button type="submit" class="btn btn-create-salary">
                        <i class="bi bi-check-circle me-2"></i>Update Salary
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-2"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const baseSalary = document.querySelector('[name="BaseSalary"]');
            const bonus = document.querySelector('[name="Bonus"]');
            const deductions = document.querySelector('[name="Deductions"]');

            function updateSummary() {
                const base = parseFloat(baseSalary.value || 0);
                const bon = parseFloat(bonus.value || 0);
                const ded = parseFloat(deductions.value || 0);
                const net = base + bon - ded;

                document.getElementById('summaryBase').textContent = '₹' + base.toFixed(2);
                document.getElementById('summaryBonus').textContent = '+₹' + bon.toFixed(2);
                document.getElementById('summaryDeductions').textContent = '-₹' + ded.toFixed(2);
                document.getElementById('summaryNet').textContent = '₹' + net.toFixed(2);
            }

            [baseSalary, bonus, deductions].forEach(el => {
                if (el) {
                    el.addEventListener('input', updateSummary);
                }
            });

            updateSummary();
        });
    </script>
}