@model IQueryable<MVC_Project.Models.Models.Salaries>
@{
    ViewData["Title"] = "Salary Management";
}

<div class="salary-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-cash-stack me-3"></i>Salary Management</h1>
            <p class="mb-0 mt-2 opacity-75">Manage and track employee compensation</p>
        </div>
        <a asp-action="Create" class="btn btn-create-salary">
            <i class="bi bi-plus-circle me-2"></i>Add New Salary
        </a>
    </div>
</div>

@if (Model.Count() == 0)
{
    <div class="empty-state">
        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
        <h5 class="mt-3">No Salary Records Found</h5>
        <p>Start by creating the first salary record for your employees.</p>
        <a asp-action="Create" class="btn btn-create-salary mt-3">
            <i class="bi bi-plus-circle me-2"></i>Create Salary Record
        </a>
    </div>
}
else
{
    <div class="row mb-4">
        @{
            decimal totalBaseSalary = Model.Sum(s => s.BaseSalary);
            decimal totalBonus = Model.Sum(s => s.Bonus);
            decimal totalDeductions = Model.Sum(s => s.Deductions);
            decimal totalNetSalary = Model.Sum(s => s.BaseSalary + s.Bonus - s.Deductions);
        }

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="salary-stat-card salary-base-card">
                <div class="stat-icon">
                    <i class="bi bi-cash"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Base Salary</span>
                    <span class="stat-value">
                        @{
                            string formattedBaseSalary;
                            if (totalBaseSalary >= 1000000)
                                formattedBaseSalary = "$" + (totalBaseSalary / 1000000).ToString("F1") + "M";
                            else if (totalBaseSalary >= 1000)
                                formattedBaseSalary = "$" + (totalBaseSalary / 1000).ToString("F0") + "K";
                            else
                                formattedBaseSalary = totalBaseSalary.ToString("C0");
                        }
                        @formattedBaseSalary
                    </span>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="salary-stat-card salary-bonus-card">
                <div class="stat-icon">
                    <i class="bi bi-gift"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Bonus</span>
                    <span class="stat-value">
                        @{
                            string formattedBonus;
                            if (totalBonus >= 1000000)
                                formattedBonus = "$" + (totalBonus / 1000000).ToString("F1") + "M";
                            else if (totalBonus >= 1000)
                                formattedBonus = "$" + (totalBonus / 1000).ToString("F0") + "K";
                            else
                                formattedBonus = totalBonus.ToString("C0");
                        }
                        @formattedBonus
                    </span>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="salary-stat-card salary-deduction-card">
                <div class="stat-icon">
                    <i class="bi bi-dash-circle"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Deductions</span>
                    <span class="stat-value">
                        @{
                            string formattedDeductions;
                            if (totalDeductions >= 1000000)
                                formattedDeductions = "$" + (totalDeductions / 1000000).ToString("F1") + "M";
                            else if (totalDeductions >= 1000)
                                formattedDeductions = "$" + (totalDeductions / 1000).ToString("F0") + "K";
                            else
                                formattedDeductions = totalDeductions.ToString("C0");
                        }
                        @formattedDeductions
                    </span>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="salary-stat-card salary-net-card">
                <div class="stat-icon">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Net Salary</span>
                    <span class="stat-value">
                        @{
                            string formattedNetSalary;
                            if (totalNetSalary >= 1000000)
                                formattedNetSalary = "$" + (totalNetSalary / 1000000).ToString("F1") + "M";
                            else if (totalNetSalary >= 1000)
                                formattedNetSalary = "$" + (totalNetSalary / 1000).ToString("F0") + "K";
                            else
                                formattedNetSalary = totalNetSalary.ToString("C0");
                        }
                        @formattedNetSalary
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="salary-table-card">
        <div class="table-responsive">
            <table class="table salary-table">
                <thead>
                    <tr>
                        <th><i class="bi bi-person"></i> Employee</th>
                        <th><i class="bi bi-briefcase"></i> Designation</th>
                        <th><i class="bi bi-cash"></i> Base Salary</th>
                        <th><i class="bi bi-gift"></i> Bonus</th>
                        <th><i class="bi bi-dash-circle"></i> Deductions</th>
                        <th><i class="bi bi-wallet2"></i> Net Salary</th>
                        <th style="text-align: center;"><i class="bi bi-gear"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var s in Model)
                    {
                        <tr>
                            <td>
                                <div class="employee-info">
                                    <div class="employee-avatar">
                                        <i class="bi bi-person-circle"></i>
                                    </div>
                                    <div class="employee-details">
                                        <strong>@s.Employee?.Name</strong>
                                        <small class="text-muted d-block">@s.EmployeeCode</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="designation-badge">@s.Employee?.Designation</span>
                            </td>
                            <td>
                                <span class="salary-badge salary-base">
                                    @{
                                        string formattedBase;
                                        if (s.BaseSalary >= 1000000)
                                            formattedBase = "$" + (s.BaseSalary / 1000000).ToString("F1") + "M";
                                        else if (s.BaseSalary >= 1000)
                                            formattedBase = "$" + (s.BaseSalary / 1000).ToString("F0") + "K";
                                        else
                                            formattedBase = s.BaseSalary.ToString("C0");
                                    }
                                    @formattedBase
                                </span>
                            </td>
                            <td>
                                <span class="salary-badge salary-bonus">
                                    +@{
                                        string formattedRowBonus;
                                        if (s.Bonus >= 1000000)
                                            formattedRowBonus = "$" + (s.Bonus / 1000000).ToString("F1") + "M";
                                        else if (s.Bonus >= 1000)
                                            formattedRowBonus = "$" + (s.Bonus / 1000).ToString("F0") + "K";
                                        else
                                            formattedRowBonus = s.Bonus.ToString("C0");
                                    }
                                    @formattedRowBonus
                                </span>
                            </td>
                            <td>
                                <span class="salary-badge salary-deduction">
                                    -@{
                                        string formattedRowDeductions;
                                        if (s.Deductions >= 1000000)
                                            formattedRowDeductions = "$" + (s.Deductions / 1000000).ToString("F1") + "M";
                                        else if (s.Deductions >= 1000)
                                            formattedRowDeductions = "$" + (s.Deductions / 1000).ToString("F0") + "K";
                                        else
                                            formattedRowDeductions = s.Deductions.ToString("C0");
                                    }
                                    @formattedRowDeductions
                                </span>
                            </td>
                            <td>
                                <span class="salary-badge salary-net">
                                    <strong>
                                        @{
                                            var rowNet = s.BaseSalary + s.Bonus - s.Deductions;
                                            string formattedRowNet;
                                            if (rowNet >= 1000000)
                                                formattedRowNet = "$" + (rowNet / 1000000).ToString("F1") + "M";
                                            else if (rowNet >= 1000)
                                                formattedRowNet = "$" + (rowNet / 1000).ToString("F0") + "K";
                                            else
                                                formattedRowNet = rowNet.ToString("C0");
                                        }
                                        @formattedRowNet
                                    </strong>
                                </span>
                            </td>
                            <td style="text-align: center;">
                                <div class="salary-actions">
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-action btn-view" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-action btn-edit" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-action btn-delete" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
