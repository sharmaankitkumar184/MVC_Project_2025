@model IQueryable<MVC_Project.Models.Models.Salaries>
@{
    ViewData["Title"] = "Salary Management";
}

<div class="salary-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-cash-stack me-3"></i>Salary Management</h1>
            <p class="mb-0 mt-2 opacity-75">Manage and track employee compensation</p>
        </div>
        <a asp-action="Create" class="btn btn-create-salary">
            <i class="bi bi-plus-circle me-2"></i>Add New Salary
        </a>
    </div>
</div>

@if (Model.Count() == 0)
{
    <div class="empty-state">
        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
        <h5 class="mt-3">No Salary Records Found</h5>
        <p>Start by creating the first salary record for your employees.</p>
        <a asp-action="Create" class="btn btn-create-salary mt-3">
            <i class="bi bi-plus-circle me-2"></i>Create Salary Record
        </a>
    </div>
}
else
{
    <div class="row mb-4">
        @{
            decimal totalBaseSalary = Model.Sum(s => s.BaseSalary);
            decimal totalBonus = Model.Sum(s => s.Bonus);
            decimal totalDeductions = Model.Sum(s => s.Deductions);
            decimal totalNetSalary = Model.Sum(s => s.BaseSalary + s.Bonus - s.Deductions);
        }

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="salary-stat-card salary-base-card">
                <div class="stat-icon">
                    <i class="bi bi-cash"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Base Salary</span>
                    <span class="stat-value">@totalBaseSalary.ToString("C")</span>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="salary-stat-card salary-bonus-card">
                <div class="stat-icon">
                    <i class="bi bi-gift"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Bonus</span>
                    <span class="stat-value">@totalBonus.ToString("C")</span>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="salary-stat-card salary-deduction-card">
                <div class="stat-icon">
                    <i class="bi bi-dash-circle"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Deductions</span>
                    <span class="stat-value">@totalDeductions.ToString("C")</span>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="salary-stat-card salary-net-card">
                <div class="stat-icon">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div class="stat-content">
                    <span class="stat-label">Total Net Salary</span>
                    <span class="stat-value">@totalNetSalary.ToString("C")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="salary-table-card">
        <div class="table-responsive">
            <table class="table salary-table">
                <thead>
                    <tr>
                        <th><i class="bi bi-person"></i> Employee</th>
                        <th><i class="bi bi-briefcase"></i> Designation</th>
                        <th><i class="bi bi-cash"></i> Base Salary</th>
                        <th><i class="bi bi-gift"></i> Bonus</th>
                        <th><i class="bi bi-dash-circle"></i> Deductions</th>
                        <th><i class="bi bi-wallet2"></i> Net Salary</th>
                        <th style="text-align: center;"><i class="bi bi-gear"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var s in Model)
                    {
                        <tr>
                            <td>
                                <div class="employee-info">
                                    <div class="employee-avatar">
                                        <i class="bi bi-person-circle"></i>
                                    </div>
                                    <div class="employee-details">
                                        <strong>@s.Employee?.Name</strong>
                                        <small class="text-muted d-block">@s.EmployeeCode</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="designation-badge">@s.Employee?.Designation</span>
                            </td>
                            <td>
                                <span class="salary-badge salary-base">@s.BaseSalary.ToString("C")</span>
                            </td>
                            <td>
                                <span class="salary-badge salary-bonus">+@s.Bonus.ToString("C")</span>
                            </td>
                            <td>
                                <span class="salary-badge salary-deduction">-@s.Deductions.ToString("C")</span>
                            </td>
                            <td>
                                <span class="salary-badge salary-net"><strong>@(s.BaseSalary + s.Bonus - s.Deductions).ToString("C")</strong></span>
                            </td>
                            <td style="text-align: center;">
                                <div class="salary-actions">
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-action btn-view" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-action btn-edit" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-action btn-delete" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
