@model IQueryable<MVC_Project.Models.Models.Salaries>
@{
    ViewData["Title"] = "Salary Management";
}

<div class="salary-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-cash-stack me-3"></i>Salary Management</h1>
            <p class="mb-0 mt-2 opacity-75">Manage employee salaries and compensation</p>
        </div>
        <a asp-action="Create" class="btn btn-light btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>Add New Salary
        </a>
    </div>
</div>

@if (Model.Count() == 0)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        <strong>No salaries found.</strong> Click the button above to add a new salary record.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
else
{
    <div class="card salary-table-card">
        <div class="table-responsive">
            <table class="table salary-table">
                <thead>
                    <tr>
                        <th><i class="bi bi-person"></i> Employee</th>
                        <th><i class="bi bi-cash"></i> Base Salary</th>
                        <th><i class="bi bi-gift"></i> Bonus</th>
                        <th><i class="bi bi-dash-circle"></i> Deductions</th>
                        <th><i class="bi bi-wallet2"></i> Net Salary</th>
                        <th style="text-align: center;"><i class="bi bi-gear"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var s in Model)
                    {
                        <tr>
                            <td>
                                <div class="employee-cell">
                                    @s.Employee?.Name
                                    <br>
                                    <small class="text-muted">Code: @s.EmployeeCode</small>
                                </div>
                            </td>
                            <td>
                                <span class="salary-badge salary-base">@s.BaseSalary.ToString("C")</span>
                            </td>
                            <td>
                                <span class="salary-badge salary-bonus">@s.Bonus.ToString("C")</span>
                            </td>
                            <td>
                                <span class="salary-badge salary-deduction">@s.Deductions.ToString("C")</span>
                            </td>
                            <td>
                                <span class="salary-badge salary-net">@(s.BaseSalary + s.Bonus - s.Deductions).ToString("C")</span>
                            </td>
                            <td style="text-align: center;">
                                <div class="action-buttons justify-content-center">
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-outline-secondary btn-sm" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline-primary btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-outline-danger btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
