@model MVC_Project.Models.Models.Salaries
@{
    ViewData["Title"] = "Salary Details";
}

<div class="details-header">
    <h1><i class="bi bi-wallet2 me-2"></i>Salary Details</h1>
    <p class="mb-0 mt-2 opacity-75">@Model.Employee?.Name - Code: @Model.EmployeeCode</p>
</div>

<div class="card salary-detail-card">
    <div class="detail-row">
        <div class="detail-label"><i class="bi bi-person me-2"></i>Employee Name</div>
        <div class="detail-value">@Model.Employee?.Name</div>
    </div>

    <div class="detail-row">
        <div class="detail-label"><i class="bi bi-id-card me-2"></i>Employee Code</div>
        <div class="detail-value">@Model.EmployeeCode</div>
    </div>

    <div class="detail-row">
        <div class="detail-label"><i class="bi bi-cash me-2"></i>Base Salary</div>
        <div class="detail-value">
            <span class="salary-detail-badge badge-base">@Model.BaseSalary.ToString("C")</span>
        </div>
    </div>

    <div class="detail-row">
        <div class="detail-label"><i class="bi bi-gift me-2"></i>Bonus</div>
        <div class="detail-value">
            <span class="salary-detail-badge badge-bonus">@Model.Bonus.ToString("C")</span>
        </div>
    </div>

    <div class="detail-row">
        <div class="detail-label"><i class="bi bi-dash-circle me-2"></i>Deductions</div>
        <div class="detail-value">
            <span class="salary-detail-badge badge-deduction">@Model.Deductions.ToString("C")</span>
        </div>
    </div>

    <div class="detail-row" style="background-color: #f8f9fa;">
        <div class="detail-label"><i class="bi bi-wallet2 me-2"></i>Net Salary</div>
        <div class="detail-value">
            <span class="salary-detail-badge badge-net">@(Model.BaseSalary + Model.Bonus - Model.Deductions).ToString("C")</span>
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        <i class="bi bi-pencil me-2"></i>Edit Salary
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to List
    </a>
</div>
