@model MVC_Project.Models.Models.Salaries
@{
    ViewData["Title"] = "Add New Salary";
}

<div class="salary-header">
    <h1><i class="bi bi-plus-circle me-2"></i>Add New Salary Record</h1>
    <p class="mb-0 mt-2 opacity-75">Create a new salary entry for an employee</p>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="salary-form-card">
            <form asp-action="Create" method="post" novalidate>
                <!-- Employee Selection -->
                <div class="form-section">
                    <h5 class="form-section-title">
                        <i class="bi bi-person-circle me-2"></i>Employee Information
                    </h5>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-person me-2"></i>Select Employee <span class="text-danger">*</span>
                        </label>
                        @{
                            var _items = new SelectList(ViewBag.Employees, "EmployeeCode", "Name");
                        }
                        <select asp-for="EmployeeCode" class="form-select" asp-items="@(_items)" required>
                            <option value="">-- Choose an Employee --</option>
                        </select>
                        <span asp-validation-for="EmployeeCode" class="text-danger small mt-2 d-block"></span>
                    </div>
                </div>

                <!-- Salary Components -->
                <div class="form-section">
                    <h5 class="form-section-title">
                        <i class="bi bi-calculator me-2"></i>Salary Components
                    </h5>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-cash me-2"></i>Base Salary <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="BaseSalary" class="form-control" type="number" step="0.01" placeholder="0.00" required>
                                </div>
                                <span asp-validation-for="BaseSalary" class="text-danger small mt-2 d-block"></span>
                                <small class="text-muted">Core monthly salary amount</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="bi bi-gift me-2"></i>Bonus
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="Bonus" class="form-control" type="number" step="0.01" placeholder="0.00">
                                </div>
                                <span asp-validation-for="Bonus" class="text-danger small mt-2 d-block"></span>
                                <small class="text-muted">Additional bonus/incentive</small>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-dash-circle me-2"></i>Deductions
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="Deductions" class="form-control" type="number" step="0.01" placeholder="0.00">
                        </div>
                        <span asp-validation-for="Deductions" class="text-danger small mt-2 d-block"></span>
                        <small class="text-muted">Tax, insurance, and other deductions</small>
                    </div>
                </div>

                <!-- Salary Formula Info -->
                <div class="salary-formula-card">
                    <div class="formula-header">
                        <i class="bi bi-info-circle me-2"></i>
                        <span>Net Salary Calculation</span>
                    </div>
                    <div class="formula-content">
                        <p><strong>Net Salary =</strong> Base Salary + Bonus - Deductions</p>
                        <small class="text-muted">This will be automatically calculated when you submit the form.</small>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="button-group">
                    <button type="submit" class="btn btn-create-salary">
                        <i class="bi bi-check-circle me-2"></i>Create Salary Record
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-2"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const baseSalary = document.querySelector('[name="BaseSalary"]');
            const bonus = document.querySelector('[name="Bonus"]');
            const deductions = document.querySelector('[name="Deductions"]');

            // Live calculation display (optional)
            [baseSalary, bonus, deductions].forEach(el => {
                if (el) {
                    el.addEventListener('input', function () {
                        console.log('Net Salary will be: ', 
                            (parseFloat(baseSalary.value || 0) + parseFloat(bonus.value || 0) - parseFloat(deductions.value || 0)).toFixed(2)
                        );
                    });
                }
            });
        });
    </script>
}