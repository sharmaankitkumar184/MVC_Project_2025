@using MVC_Project.Models.ViewModel
@model EmployeeProfileViewModel
@{
    <link rel="stylesheet" href="~/css/Profile.css" asp-append-version="true" />
    ViewData["Title"] = "My Profile";
}


<div class="container-fluid py-4">

    @* Alerts *@
    @{
        var success = TempData["Success"] ?? TempData["SuccessMessage"];
        var error = TempData["Error"] ?? TempData["ErrorMessage"];
    }

    @if (success != null)
    {
        <div class="alert-custom success">
            <span>✓</span>
            <span>@success</span>
        </div>
    }

    @if (error != null)
    {
        <div class="alert-custom error">
            <span>✕</span>
            <span>@error</span>
        </div>
    }

    <!-- PROFILE HEADER -->
    <div class="profile-header">
        <div class="row align-items-center">
            <div class="col-md-auto text-center">
                <div class="profile-image-wrapper">
                    <img src="@(string.IsNullOrEmpty(Model.ProfileImagePath)
                                 ? Url.Content("~/images/default-profile.png")
                                 : Url.Content(Model.ProfileImagePath))"
                         alt="@Model.FullName"
                         class="profile-image" />
                    <form asp-action="UploadProfileImage" method="post" enctype="multipart/form-data" id="profileImageForm" style="display: inline;">
                        <button type="button" class="profile-edit-btn" onclick="document.getElementById('profileImageInput').click(); return false;">
                            📷
                        </button>
                        <input type="file" name="ProfileImageFile" id="profileImageInput" accept="image/*" style="display:none" onchange="document.getElementById('profileImageForm').submit();" />
                    </form>
                </div>
            </div>

            <div class="col-md profile-info-main">
                <h1 class="profile-name">@Model.FullName</h1>
                <p class="profile-designation">@Model.Designation</p>

                <div class="profile-stats">
                    <div class="stat-item">
                        <div class="stat-icon">📊</div>
                        <div class="stat-text">
                            <span class="stat-label">Activities</span>
                            <span class="stat-value">@Model.Activities</span>
                        </div>
                    </div>

                    <div class="stat-item">
                        <div class="stat-icon">⏳</div>
                        <div class="stat-text">
                            <span class="stat-label">Experience</span>
                            <span class="stat-value">@Model.ExperienceYears yrs</span>
                        </div>
                    </div>

                    <div class="stat-item">
                        <div class="stat-icon">🏢</div>
                        <div class="stat-text">
                            <span class="stat-label">Department</span>
                            <span class="stat-value">@Model.DepartmentName</span>
                        </div>
                    </div>
                </div>

                <div class="quick-actions">
                    <a href="@Url.Action("EditProfile")" class="btn-action">✏️ Edit Profile</a>
                    <a href="@Url.Action("DownloadProfileData")" class="btn-action">⬇️ Download Data</a>
                    <button type="button" class="btn-action" onclick="printProfile()">🖨️ Print</button>
                </div>

                <div class="profile-completion">
                    <p style="margin-bottom: 0.8rem; font-size: 0.9rem;">Profile Completion</p>
                    <div class="progress-bar-wrapper">
                        <div class="progress" style="flex: 1;">
                            <div class="progress-bar" style="width: @(Model.IsProfileComplete ? "100" : "75")%"></div>
                        </div>
                        <span style="font-size: 0.9rem;">@(Model.IsProfileComplete ? "100%" : "75%")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- INFO CARDS -->
    <div class="row mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="info-card">
                <div class="card-title">
                    <div class="card-title-icon">👤</div>
                    Status
                </div>
                <div class="badge-status">
                    <span>●</span> @Model.EmploymentStatus
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="info-card">
                <div class="card-title">
                    <div class="card-title-icon">📅</div>
                    Joining Date
                </div>
                <p class="info-value">@Model.JoiningDate</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="info-card">
                <div class="card-title">
                    <div class="card-title-icon">🎯</div>
                    Projects
                </div>
                <p class="info-value">@Model.ProjectName</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="info-card">
                <div class="card-title">
                    <div class="card-title-icon">⏱️</div>
                    Time Zone
                </div>
                <p class="info-value">@Model.TimeZone</p>
            </div>
        </div>
    </div>

    <!-- DETAILED INFORMATION TABS -->
    <div class="info-card">
        <ul class="nav nav-tabs" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab">
                    📋 Employee Details
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact" type="button" role="tab">
                    📞 Contact Information
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="organization-tab" data-bs-toggle="tab" data-bs-target="#organization" type="button" role="tab">
                    🏢 Organization
                </button>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content p-4">
            <!-- EMPLOYEE DETAILS TAB -->
            <div class="tab-pane fade show active" id="details" role="tabpanel">
                <h5 class="mb-3">Personal Information</h5>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Employee Code</div>
                        <div class="info-value">@Model.EmployeeCode</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Gender</div>
                        <div class="info-value">@Model.Gender</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Date of Birth</div>
                        <div class="info-value">@Model.DateOfBirth.ToShortDateString()</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Blood Group</div>
                        <div class="info-value">@Model.BloodGroup</div>
                    </div>
                </div>

                <hr class="my-4">

                <h5 class="mb-3">Professional Information</h5>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Designation</div>
                        <div class="info-value">@Model.Designation</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Department</div>
                        <div class="info-value">@Model.DepartmentName</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Company</div>
                        <div class="info-value">@Model.CompanyName</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Skills</div>
                        <div class="info-value">@Model.SkillsSummary</div>
                    </div>
                </div>
            </div>

            <!-- CONTACT INFORMATION TAB -->
            <div class="tab-pane fade" id="contact" role="tabpanel">
                <h5 class="mb-3">Contact Details</h5>
                <div class="contact-methods">
                    <a href="mailto:@Model.Email" class="contact-method">
                        <div class="contact-icon">✉️</div>
                        <div>
                            <div style="font-size: 0.85rem; color: rgba(0,0,0,0.6);">Email</div>
                            <div style="font-weight: 600;">@Model.Email</div>
                        </div>
                    </a>

                    <a href="tel:@Model.PhoneNumber" class="contact-method">
                        <div class="contact-icon">📱</div>
                        <div>
                            <div style="font-size: 0.85rem; color: rgba(0,0,0,0.6);">Phone</div>
                            <div style="font-weight: 600;">@Model.PhoneNumber</div>
                        </div>
                    </a>

                    <div class="contact-method">
                        <div class="contact-icon">📍</div>
                        <div>
                            <div style="font-size: 0.85rem; color: rgba(0,0,0,0.6);">Address</div>
                            <div style="font-weight: 600;">@Model.Address</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ORGANIZATION TAB -->
            <div class="tab-pane fade" id="organization" role="tabpanel">
                <h5 class="mb-3">Reporting Structure</h5>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Reporting Manager</div>
                        <div class="info-value">@Model.ReportingManager</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Team Members</div>
                        <div class="info-value">@Model.TeamMembersCount</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Project</div>
                        <div class="info-value">@Model.ProjectName</div>
                    </div>
                </div>

                <hr class="my-4">

                <h5 class="mb-3">Account Information</h5>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Username</div>
                        <div class="info-value">@Model.Username</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Role</div>
                        <div class="info-value">@Model.Role</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Date of Registration</div>
                        <div class="info-value">@Model.DateOfRegister.ToShortDateString()</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ACTION BUTTONS -->
    <div class="btn-group-custom">
        <a href="@Url.Action("EditProfile")" class="btn-custom btn-primary-custom">
            ✏️ Edit Profile
        </a>
        <a href="@Url.Action("DownloadProfileData")" class="btn-custom btn-primary-custom">
            ⬇️ Download Profile Data
        </a>
        <a href="@Url.Action("Dashboard", "EmployeeDashboard")" class="btn-custom btn-secondary-custom">
            ← Back to Dashboard
        </a>
    </div>

</div>

<script type="text/javascript">
    function printProfile() {
        window.print();
    }
</script>