@model MVC_Project.Models.ViewModel.UserRegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<h2 class="mb-4 text-center text-primary">Create an Account</h2>

<form asp-action="Register" method="post" class="shadow p-4 rounded bg-light">
    <div asp-validation-summary="All"
         class="alert alert-danger validation-summary mb-4">

        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-exclamation-octagon-fill fs-5 mt-1"></i>

            <div>
                <div class="fw-semibold mb-1">
                    There was a problem
                </div>

                <ul class="validation-list mb-0">
                    @* MVC renders errors here *@
                </ul>
            </div>
        </div>
    </div>

    <div class="form-group mb-3">
        <label asp-for="FullName" class="form-label text-dark"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Email" class="form-label text-dark"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Username" class="form-label text-dark"></label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="PhoneNumber" class="form-label text-dark"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Address" class="form-label text-dark"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Password" class="form-label text-dark"></label>
        <input asp-for="Password" class="form-control" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group mb-4">
        <label asp-for="ConfirmPassword" class="form-label text-dark"></label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Register</button>
</form>
