@using MVC_Project.Models.ViewModel
@model UserLoginViewModel

@{
    ViewData["Title"] = "Sign In - OrgMaster";
}

<div class="login-container">
    <!-- Left Side: Branding & Welcome -->
    <div class="login-brand-section">
        <div class="brand-content">
            <div class="brand-logo">
                <i class="bi bi-crosshair2"></i>
            </div>
            <h1 class="brand-title">OrgMaster</h1>
            <p class="brand-subtitle">Organization Management System</p>

            <div class="brand-features">
                <div class="feature">
                    <i class="bi bi-check-circle"></i>
                    <span>Manage Employees & Teams</span>
                </div>
                <div class="feature">
                    <i class="bi bi-check-circle"></i>
                    <span>Track Projects & Departments</span>
                </div>
                <div class="feature">
                    <i class="bi bi-check-circle"></i>
                    <span>Streamline Payroll Management</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side: Login Form -->
    <div class="login-form-section">
        <div class="login-card">
            <!-- Header -->
            <div class="login-header">
                <h2><i class="bi bi-box-arrow-in-right me-2"></i>Welcome Back</h2>
                <p>Sign in to your account to continue</p>
            </div>

            <!-- Form -->
            <form asp-action="Login" method="post" class="login-form">
                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-alert">
                        <div class="alert-header">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span>Login Failed</span>
                        </div>
                        <div asp-validation-summary="All" class="alert-errors">
                            @* MVC renders errors here *@
                        </div>
                    </div>
                }

                <!-- Email Field -->
                <div class="form-group">
                    <label asp-for="Email" class="form-label">
                        <i class="bi bi-envelope me-2"></i>Email Address
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-at"></i>
                        </span>
                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="your.email@company.com"
                               required
                               autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="invalid-feedback"></span>
                </div>

                <!-- Password Field -->
                <div class="form-group">
                    <label asp-for="Password" class="form-label">
                        <i class="bi bi-lock me-2"></i>Password
                    </label>
                    <div class="input-group password-input">
                        <span class="input-group-text">
                            <i class="bi bi-shield-lock"></i>
                        </span>
                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Enter your password"
                               required
                               autocomplete="current-password" />
                        <button class="btn btn-outline-secondary toggle-password" type="button">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="invalid-feedback"></span>
                </div>

                <!-- Help Links -->
                <div class="help-links">
                    <a href="#"
                       class="help-link"
                       data-bs-toggle="modal"
                       data-bs-target="#forgotPasswordModal">
                        <i class="bi bi-question-circle me-1"></i>Forgot Password?
                    </a>
                    <span class="divider">•</span>
                    <a href="#"
                       class="help-link"
                       data-bs-toggle="modal"
                       data-bs-target="#forgotEmailModal">
                        <i class="bi bi-question-circle me-1"></i>Forgot Email?
                    </a>
                </div>

                <!-- Sign In Button -->
                <button type="submit" class="btn btn-login w-100">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
            </form>

            <!-- Info Section -->
            <div class="login-info">
                <div class="info-icon">
                    <i class="bi bi-info-circle"></i>
                </div>
                <div class="info-content">
                    <p class="info-title">New User?</p>
                    <p class="info-text">
                        Accounts are created by administrators. Please contact your system administrator for access.
                    </p>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="login-footer">
            <p>&copy; 2025 OrgMaster. All rights reserved.</p>
        </div>
    </div>
</div>

<!-- Forgot Password Modal -->
@await Html.PartialAsync("/Views/PartialModels/_ForgotPasswordModel.cshtml")

<!-- Forgot Email Modal -->
@await Html.PartialAsync("/Views/PartialModels/_ForgotEmailAddressModel.cshtml")

<!-- Password Toggle Script -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggleBtns = document.querySelectorAll('.toggle-password');
        toggleBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const input = this.parentElement.querySelector('input');
                const icon = this.querySelector('i');

                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });
    });
</script>
