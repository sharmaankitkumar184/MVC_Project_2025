@model MVC_Project.Models.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="delete-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-trash2 me-3"></i>Delete Employee</h1>
            <p>Permanent removal - This action cannot be undone</p>
        </div>
    </div>
</div>

<div class="card delete-card">
    <div class="card-body">
        <!-- Validation Errors -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-alert alert-danger">
                <strong><i class="bi bi-exclamation-circle me-2"></i>Validation Error</strong>
                @Html.ValidationSummary(false)
            </div>
        }

        <!-- Warning Banner -->
        <div class="warning-banner">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div class="warning-banner-content">
                <h5>Critical Action</h5>
                <p>Are you absolutely sure you want to permanently delete this employee? This action cannot be reversed and all associated data may be lost.</p>
            </div>
        </div>

        <!-- Employee Details Section -->
        <h6 class="mb-3" style="font-weight: 700; color: #495057; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.05em;">
            <i class="bi bi-person-fill me-2" style="color: #dc3545;"></i>Employee to be Deleted
        </h6>

        <div class="employee-details">
            <div class="detail-row">
                <div class="detail-label">
                    <i class="bi bi-person"></i> Full Name
                </div>
                <div class="detail-value">@Model.Name</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">
                    <i class="bi bi-hash"></i> Employee Code
                </div>
                <div class="detail-value">@Model.EmployeeCode</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">
                    <i class="bi bi-briefcase"></i> Designation
                </div>
                <div class="detail-value">@Model.Designation</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">
                    <i class="bi bi-envelope"></i> Email
                </div>
                <div class="detail-value">@Model.Email</div>
            </div>

            <div class="detail-row">
                <div class="detail-label">
                    <i class="bi bi-building"></i> Department
                </div>
                <div class="detail-value">@(Model.Department?.Name ?? "N/A")</div>
            </div>
        </div>

        <!-- Dangerous Action Note -->
        <div class="dangerous-action-note">
            <i class="bi bi-exclamation-diamond"></i>
            All associated salary records, documents, and historical data will be deleted.
        </div>

        <!-- Action Buttons -->
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="button-group">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-2"></i>Yes, Delete Employee
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-2"></i>Cancel, Keep Employee
                </a>
            </div>
        </form>
    </div>
</div>