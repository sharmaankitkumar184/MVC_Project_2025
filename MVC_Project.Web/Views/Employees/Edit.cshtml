@using MVC_Project.Models.Enums
@using MVC_Project.Models.Models
@model MVC_Project.Models.ViewModel.EmployeeUserVm

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="form-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-pencil-square me-3"></i>Edit Employee</h1>
            <p>Update employee information and details</p>
        </div>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Edit">
            <!-- Validation Summary -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-alert alert-danger">
                    <strong><i class="bi bi-exclamation-circle me-2"></i>Validation Error</strong>
                    @Html.ValidationSummary(false)
                </div>
            }

            <!-- Hidden Fields -->
            <input type="hidden" asp-for="Id" />

            <!-- Personal Information Section -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-person-fill" style="color: #667eea;"></i>
                    Personal Information
                </div>

                <div class="two-col-row">
                    <div class="form-group">
                        <label asp-for="Name"><i class="bi bi-person me-2"></i>Full Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter employee name" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EmployeeCode"><i class="bi bi-hash me-2"></i>Employee Code</label>
                        <input asp-for="EmployeeCode" class="form-control" placeholder="Code" disabled />
                        <span asp-validation-for="EmployeeCode" class="text-danger"></span>
                    </div>
                </div>

                <div class="two-col-row">
                    <div class="form-group">
                        <label asp-for="DateOfBirth"><i class="bi bi-calendar-event me-2"></i>Date of Birth</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" required />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Gender"><i class="bi bi-person-badge me-2"></i>Gender</label>
                        <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select" required>
                            <option value="">-- Select Gender --</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Contact Information Section -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-telephone-fill" style="color: #667eea;"></i>
                    Contact Information
                </div>

                <div class="two-col-row">
                    <div class="form-group">
                        <label asp-for="Email"><i class="bi bi-envelope me-2"></i>Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="employee@example.com" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Phone"><i class="bi bi-telephone me-2"></i>Phone</label>
                        <input asp-for="Phone" class="form-control" placeholder="+1 (555) 000-0000" required />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Organization Section -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-building" style="color: #667eea;"></i>
                    Organization
                </div>

                <div class="two-col-row">
                    <div class="form-group">
                        <label asp-for="Designation"><i class="bi bi-briefcase me-2"></i>Designation</label>
                        <select asp-for="Designation" asp-items="Html.GetEnumSelectList<Designation>()" class="form-select" required>
                            <option value="">-- Select Designation --</option>
                        </select>
                        <span asp-validation-for="Designation" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DepartmentId"><i class="bi bi-diagram-3 me-2"></i>Department</label>
                        <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments" required>
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="AddressId"><i class="bi bi-geo-alt me-2"></i>Address</label>
                    <select asp-for="AddressId" class="form-select" asp-items="ViewBag.Addresses">
                        <option value="">-- Select Address --</option>
                    </select>
                    <span asp-validation-for="AddressId" class="text-danger"></span>
                </div>
            </div>

            <!-- Role Section (Admin Only) -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-shield-lock" style="color: #667eea;"></i>
                    Access Control
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="form-group">
                        <label asp-for="Role"><i class="bi bi-key me-2"></i>User Role</label>
                        <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>()" class="form-select" required>
                            <option value="">-- Select Role --</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label asp-for="Role"><i class="bi bi-key me-2"></i>User Role</label>
                        <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>()" class="form-select" disabled>
                        </select>
                        <div class="alert alert-warning">
                            <i class="bi bi-info-circle me-2"></i>
                            Role modification is restricted to administrators.
                        </div>
                        <input type="hidden" asp-for="Role" />
                    </div>
                }
            </div>

            <!-- Action Buttons -->
            <div class="button-group">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-2"></i>Save Changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
