@model X.PagedList.IPagedList<MVC_Project.Models.Models.Employee>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Employee Management";
    var employeeList = Model;
    bool isSearchActive = !string.IsNullOrEmpty(ViewBag.SearchQuery as string);
    bool hasRecords = employeeList != null && employeeList.Any();
}

<div class="employee-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-people-fill me-3"></i>Employee Management</h1>
            <p>Manage and organize your workforce</p>
        </div>
        <a asp-action="Create" class="btn btn-create-employee">
            <i class="bi bi-plus-circle me-2"></i>Add New Employee
        </a>
    </div>
</div>

<!-- Search Section -->
<div class="search-section">
    <form class="search-input-group" asp-action="Search" id="searchForm">
        <input class="form-control" type="text" name="empName" id="searchInput"
               placeholder="🔍 Search by employee name..." value="@ViewBag.SearchQuery">
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-search"></i> Search
        </button>
        <button type="button" class="btn btn-outline-secondary" id="clearSearch">
            <i class="bi bi-x-circle"></i> Clear
        </button>
    </form>
</div>

<!-- No Results Alert -->
@if (isSearchActive && !hasRecords)
{
    <div class="no-results-alert alert-warning">
        <i class="bi bi-inbox" style="font-size: 2rem; color: #856404;"></i>
        <h5 class="mt-2 text-dark">No Employees Found</h5>
        <p class="text-dark mb-0">Try searching with a different name or create a new employee.</p>
    </div>
}
else
{
    <!-- Employee Cards Grid -->
    <div class="row">
        @foreach (var item in employeeList)
        {
            <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                <div class="card employee-card">
                    <span class="designation-badge">
                        <i class="bi bi-briefcase me-1"></i>@item.Designation
                    </span>

                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <h6 class="card-subtitle">
                            <i class="bi bi-hash"></i> @item.EmployeeCode
                        </h6>

                        <div class="employee-info-row">
                            <span class="employee-info-label">
                                <i class="bi bi-calendar-event" style="color: #667eea;"></i> DOB
                            </span>
                            <span class="employee-info-value">@item.DateOfBirth.ToString("dd MMM yyyy")</span>
                        </div>

                        <div class="employee-info-row">
                            <span class="employee-info-label">
                                <i class="bi bi-envelope" style="color: #667eea;"></i> Email
                            </span>
                            <span class="employee-info-value">@(string.IsNullOrEmpty(item.Email) ? "N/A" : item.Email)</span>
                        </div>

                        <div class="employee-info-row">
                            <span class="employee-info-label">
                                <i class="bi bi-telephone" style="color: #667eea;"></i> Phone
                            </span>
                            <span class="employee-info-value">@(string.IsNullOrEmpty(item.Phone) ? "N/A" : item.Phone)</span>
                        </div>

                        <div class="employee-info-row">
                            <span class="employee-info-label">
                                <i class="bi bi-building" style="color: #667eea;"></i> Dept
                            </span>
                            <span class="info-badge badge-department">
                                @(item.Department != null ? item.Department.Name : "N/A")
                            </span>
                        </div>

                        @if (item.Salary != null)
                        {
                            <div class="employee-info-row">
                                <span class="employee-info-label">
                                    <i class="bi bi-wallet2" style="color: #667eea;"></i> Salary
                                </span>
                                <span class="info-badge badge-salary">
                                    @((item.Salary.BaseSalary + item.Salary.Bonus - item.Salary.Deductions).ToString("C"))
                                </span>
                            </div>
                        }

                        <div class="employee-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-action btn-edit" title="Edit Employee">
                                <i class="bi bi-pencil-square"></i>
                                <span>Edit</span>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-action btn-view" title="View Details">
                                <i class="bi bi-eye"></i>
                                <span>Details</span>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-action btn-delete" title="Delete Employee">
                                <i class="bi bi-trash"></i>
                                <span>Delete</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Pagination + Page Size UI -->
@if (hasRecords)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <!-- Page Size Buttons -->
        <div class="d-flex align-items-center gap-2">
            <span class="fw-semibold text-secondary" id="page-text-style">Page Size:</span>
            @foreach (var size in new int[] { 3, 6, 9, 12 })
            {
                <button class="btn page-size-button @(ViewBag.PageSize == size ? "custom-page-active" : "")"
                        onclick="changePageSize('@(ViewBag.SearchQuery ?? "")', @(size))">
                    @size
                </button>
            }
        </div>
    </div>

    <!-- Pagination at Bottom -->
    <div class="d-flex justify-content-center mt-3">
        @{
            var renderOptions = new PagedListRenderOptions
            {
                UlElementClasses = new[] { "pagination", "justify-content-center" },
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" },
                ActiveLiElementClass = "active"
            };
        }
        @* // Render the pagination links *@
        @if (isSearchActive)
        {
            @Html.PagedListPager(Model, page => Url.Action("Search", new
            {
                page,
                empName = ViewBag.SearchQuery,
                pageSize = ViewBag.PageSize
            }), renderOptions)
        }
        else
        {
            @Html.PagedListPager(Model, page => Url.Action("Index", new
            {
                page,
                pageSize = ViewBag.PageSize
            }), renderOptions)
        }
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("searchInput");
            const clearButton = document.getElementById("clearSearch");

            clearButton.addEventListener("click", function () {
                searchInput.value = ""; // Clear input field
                window.location.href = '@Url.Action("Index")'; // Reset and reload page
            });
        });
        var isSearchActive = @isSearchActive.ToString().ToLower();

        // JavaScript to Handle Page Size Change
        function changePageSize(empName, size) {
            // ✅ Get empName from input field
            var empName = document.getElementById("searchInput") ? document.getElementById("searchInput").value.trim() : "";

            if (isSearchActive) {  // ✅ Works correctly as a Boolean now
                var url = '@Url.Action("Search", new { page = 1 })' + '&empName=' + encodeURIComponent(empName) + '&pageSize=' + size;
                window.location.href = url;
            } else {
                var url = '@Url.Action("Index", new { page = 1 })' + '&pageSize=' + size;
                window.location.href = url;
            }
        }
    </script>
}
