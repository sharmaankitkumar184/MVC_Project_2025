@model IQueryable<MVC_Project.Models.Models.Department>

@{
    ViewData["Title"] = "Department Management";
}

<!-- Success Message -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="dept-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-building me-3"></i>Department Management</h1>
            <p>Organize and manage your company departments</p>
        </div>
        <a asp-action="Create" class="btn btn-create-department">
            <i class="bi bi-plus-circle me-2"></i>Add New Department
        </a>
    </div>
</div>

<div class="dept-table-card">
    <div class="table-responsive">
        <table class="table dept-table mb-0">
            <thead>
                <tr>
                    <th><i class="bi bi-tag"></i> Name</th>
                    <th><i class="bi bi-file-text"></i> Description</th>
                    <th><i class="bi bi-toggle2-on"></i> Status</th>
                    <th><i class="bi bi-calendar-event"></i> Created</th>
                    <th style="text-align: center;"><i class="bi bi-gear"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dept in Model)
                {
                    <tr>
                        <td>
                            <div class="dept-name">
                                <i class="bi bi-building"></i>
                                <strong>@dept.Name</strong>
                            </div>
                        </td>

                        <td>
                            <span class="dept-description" title="@dept.Description">
                                @(string.IsNullOrEmpty(dept.Description) ? "—" : dept.Description)
                            </span>
                        </td>

                        <td>
                            @if (dept.IsActive)
                            {
                                <span class="badge badge-status-active">
                                    <i class="bi bi-check-circle me-1"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-status-inactive">
                                    <i class="bi bi-x-circle me-1"></i> Inactive
                                </span>
                            }
                        </td>

                        <td>
                            <small class="text-muted">@dept.CreatedAt.ToString("dd MMM yyyy")</small>
                        </td>

                        <td style="text-align: center;">
                            <div class="dept-action-buttons">
                                <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-icon-edit" title="Edit Department">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@dept.Id" class="btn btn-icon-details" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    setTimeout(() => {
        const alert = document.querySelector('.alert');
        if (alert) {
            alert.classList.add('fade');
            setTimeout(() => alert.remove(), 4000);
        }
    }, 4000);
</script>
