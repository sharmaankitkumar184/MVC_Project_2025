@model MVC_Project.Models.Models.Department

@{
    ViewData["Title"] = "Department Details";
    int employeeCount = ViewBag.EmployeeCount ?? 0;
    int projectCount = ViewBag.ProjectCount ?? 0;
}

<div class="dept-details-header">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1><i class="bi bi-building me-3"></i>@Model.Name</h1>
            <p>Department overview and information</p>
        </div>
        <div class="action-buttons">
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-arrow-left me-2"></i>Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-lg">
                <i class="bi bi-pencil me-2"></i>Edit Department
            </a>
            <button class="btn btn-danger btn-lg" data-bs-toggle="modal" data-bs-target="#deleteDepartmentModal">
                <i class="bi bi-trash me-2"></i>Delete
            </button>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="dept-stat-card employees">
            <div class="stat-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Employees</p>
                <p class="stat-number">@employeeCount</p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="dept-stat-card projects">
            <div class="stat-icon">
                <i class="bi bi-kanban"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Projects</p>
                <p class="stat-number">@projectCount</p>
            </div>
        </div>
    </div>
</div>

<!-- Department Details Card -->
<div class="dept-detail-card">
    <div class="detail-section">
        <!-- Status -->
        <div class="status-section">
            <h6 class="section-label"><i class="bi bi-toggle2-on me-2"></i>Status</h6>
            @if (Model.IsActive)
            {
                <span class="badge badge-status-active">
                    <i class="bi bi-check-circle me-1"></i> Active
                </span>
            }
            else
            {
                <span class="badge badge-status-inactive">
                    <i class="bi bi-x-circle me-1"></i> Inactive
                </span>
            }
        </div>

        <!-- Description -->
        <div class="description-section">
            <h6 class="section-label"><i class="bi bi-file-text me-2"></i>Description</h6>
            <p class="section-content">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
            </p>
        </div>

        <hr class="my-4" />

        <!-- Metadata -->
        <div class="row metadata-section">
            <div class="col-md-6">
                <div class="metadata-item">
                    <span class="metadata-label"><i class="bi bi-calendar-event me-2"></i>Created Date</span>
                    <span class="metadata-value">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="metadata-item">
                    <span class="metadata-label"><i class="bi bi-arrow-repeat me-2"></i>Last Updated</span>
                    <span class="metadata-value">
                        @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd MMM yyyy") : "—")
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Department Modal -->
<div class="modal fade" id="deleteDepartmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <!-- Header -->
            <div class="modal-header border-0 bg-danger bg-opacity-10">
                <h5 class="modal-title text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Delete Department
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body p-4">
                <p class="mb-3">
                    Are you sure you want to delete <strong>@Model.Name</strong>?
                </p>

                @if (employeeCount > 0)
                {
                    <div class="alert alert-warning border-0 rounded-3 small mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        This department has <strong>@employeeCount</strong>
                        @(employeeCount == 1 ? "employee" : "employees").
                        They will be moved to <strong>Bench</strong> department.
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        This action cannot be undone.
                    </p>
                }
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Cancel
                </button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Yes, Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>


