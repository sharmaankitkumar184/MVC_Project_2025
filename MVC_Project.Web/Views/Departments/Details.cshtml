@model MVC_Project.Models.Models.Department

@{
    ViewData["Title"] = "Department Details";
    int employeeCount = ViewBag.EmployeeCount ?? 0;
    int projectCount = @ViewBag.ProjectCount ?? 0;
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-5 mt-4">
        <div>
            <h2 class="fw-bold mb-1">@Model.Name</h2>
            <p class="text-muted mb-0" id="deptText">Department details overview</p>
             
        </div>


        <div class="d-flex gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>

            <button class="btn btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#deleteDepartmentModal">
                <i class="bi bi-trash me-1"></i> Delete
            </button>

            <a asp-action="Index"
               class="btn btn-light">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>

    </div>


    <div class="row g-3 mb-4">

        <!-- Employee Count -->
        <div class="col-md-3">
            <div class="stat-card">
                <div class="icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div class="stat-value">@employeeCount</div>
                    <div class="stat-label">Employees</div>
                </div>
            </div>
        </div>

        <!-- Project Count -->
        <div class="col-md-3">
            <div class="stat-card">
                <div class="icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-kanban-fill"></i>
                </div>
                <div>
                    <div class="stat-value">@projectCount</div>
                    <div class="stat-label">Projects</div>
                </div>
            </div>
        </div>

    </div>


    <!-- Main Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <!-- Status -->
            <div class="mb-4">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2">
                        <i class="bi bi-check-circle me-1"></i> Active
                    </span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2">
                        <i class="bi bi-x-circle me-1"></i> Inactive
                    </span>
                }
            </div>

            <!-- Description -->
            <div class="mb-4">
                <h6 class="text-uppercase text-muted fw-semibold mb-2">
                    Description
                </h6>

                <p class="mb-0 fs-6">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                                        ? "No description provided."
                                        : Model.Description)
                </p>
            </div>

            <hr />

            <!-- Metadata -->
            <div class="row g-4">

                <div class="col-md-4">
                    <div class="detail-box">
                        <div class="label">Created At</div>
                        <div class="value">
                            @Model.CreatedAt.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="detail-box">
                        <div class="label">Last Updated</div>
                        <div class="value">
                            @(Model.UpdatedAt.HasValue
                                                        ? Model.UpdatedAt.Value.ToString("dd MMM yyyy")
                                                        : "—")
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="detail-box">
                        <div class="label">Department ID</div>
                        <div class="value">
                            #@Model.Id
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="deleteDepartmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">

            <!-- Header -->
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Delete Department
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body">

                <p class="mb-2">
                    Are you sure you want to delete
                    <strong>@Model.Name</strong>?
                </p>

                @if (employeeCount > 0)
                {
                    <div class="alert alert-warning border-0 rounded-3 small">
                        <i class="bi bi-info-circle me-1"></i>
                        This department has
                        <strong>@employeeCount</strong>
                        @(employeeCount == 1 ? "employee" : "employees").
                        They will be moved to
                        <strong>Bench</strong> department.
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">
                        This action cannot be undone.
                    </p>
                }

            </div>

            <!-- Footer -->
            <div class="modal-footer border-0">
                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn btn-danger">
                        Yes, Delete
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>


