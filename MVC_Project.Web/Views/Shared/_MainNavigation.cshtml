@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    bool isManager = User.IsInRole("Manager");
    bool isAdmin = User.IsInRole("Admin");
    bool isEmployee = User.IsInRole("Employee");
}

<header>
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar" id="mainNavbar">
        <!-- Left: Brand -->
        <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Homepage" id="navbar-brand">
            <div class="brand-logo-circle">
                <i class="bi bi-crosshair2"></i>
            </div>
            <span class="fw-bold">OrgMaster</span>
        </a>

        <!-- Toggler -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Links + User Section -->
        <div class="collapse navbar-collapse justify-content-between" id="navbarNav">

            <!-- CENTER MENU -->
            <ul class="navbar-nav mx-auto gap-lg-3 gap-2">

                <!-- Home -->
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Homepage">
                        <i class="bi bi-house-fill"></i>
                        <span>Home</span>
                    </a>
                </li>

                <!-- PEOPLE -->
                @if (isAdmin || isManager || isEmployee)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @(new[] { "Employees", "ManagerDashboard", "Bench" }.Contains(currentController) ? "active" : "")"
                           href="#" data-bs-toggle="dropdown" role="button">
                            <i class="bi bi-people-fill"></i>
                            <span>People</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-dark custom-dropdown">

                            <!-- Admin + Manager -->
                            @if (isAdmin || isManager)
                            {
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Employees" asp-action="Index">
                                        <i class="bi bi-person-badge"></i>
                                        <span>Employees</span>
                                    </a>
                                </li>
                            }

                            <!-- Salaries - Admin -->
                            @if (isAdmin)
                            {
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Salaries" asp-action="Index">
                                        <i class="bi bi-cash-stack"></i>
                                        <span>Salaries</span>
                                    </a>
                                </li>
                            }

                            <!-- Manager -->
                            @if (isManager)
                            {
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="ManagerDashboard" asp-action="MyTeam">
                                        <i class="bi bi-diagram-3"></i>
                                        <span>My Team</span>
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="TeamAttendance" asp-action="Index">
                                        <i class="bi bi-calendar-check"></i>
                                        <span>Team Attendance</span>
                                    </a>
                                </li>
                            }

                            <!-- Admin -->
                            @if (isAdmin)
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Bench" asp-action="Index">
                                        <i class="bi bi-person-dash"></i>
                                        <span>Bench</span>
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-shield-lock"></i>
                                        <span>User Management</span>
                                    </a>
                                </li>
                            }

                            <!-- Employee -->
                            @if (isEmployee)
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="EmployeeDashboard" asp-action="MyProfile">
                                        <i class="bi bi-person-circle"></i>
                                        <span>My Profile</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }

                <!-- STRUCTURE (Admin + Manager) -->
                @if (isAdmin || isManager)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @(new[] { "Departments", "Projects" }.Contains(currentController) ? "active" : "")"
                           href="#" data-bs-toggle="dropdown" role="button">
                            <i class="bi bi-diagram-2"></i>
                            <span>Structure</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-dark custom-dropdown">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Departments" asp-action="Index">
                                    <i class="bi bi-building"></i>
                                    <span>Departments</span>
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Projects" asp-action="Index">
                                    <i class="bi bi-kanban"></i>
                                    <span>Projects</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                <!-- MY SPACE (Employee only) -->
                @if (isEmployee)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"
                           href="#" data-bs-toggle="dropdown" role="button">
                            <i class="bi bi-person-check"></i>
                            <span>My Space</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-dark custom-dropdown">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="MyTasks" asp-action="Index">
                                    <i class="bi bi-list-check"></i>
                                    <span>My Tasks</span>
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Attendance" asp-action="Index">
                                    <i class="bi bi-calendar-event"></i>
                                    <span>My Attendance</span>
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Payslip" asp-action="Index">
                                    <i class="bi bi-receipt"></i>
                                    <span>Payslips</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                <!-- ADMIN -->
                @if (isAdmin)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"
                           href="#" data-bs-toggle="dropdown" role="button">
                            <i class="bi bi-gear-fill"></i>
                            <span>Admin</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-dark custom-dropdown">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Roles" asp-action="Index">
                                    <i class="bi bi-person-lock"></i>
                                    <span>Roles & Permissions</span>
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="AuditLogs" asp-action="Index">
                                    <i class="bi bi-journal-text"></i>
                                    <span>Audit Logs</span>
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Settings" asp-action="Index">
                                    <i class="bi bi-sliders"></i>
                                    <span>System Settings</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                }

            </ul>

            <!-- Right: Theme Toggle + User Menu -->
            <div class="d-flex align-items-center gap-3">
                <!-- Dark Mode Toggle -->
                <div class="theme-toggle">
                    <input class="form-check-input" type="checkbox" id="themeSwitch">
                    <label class="form-check-label" for="themeSwitch" id="themeLabel">
                        <i class="bi bi-moon-fill"></i>
                    </label>
                </div>

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <a href="#" class="nav-user-btn dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://i.pravatar.cc/32?img=5" alt="User" class="user-avatar" width="36" height="36">
                            <span class="user-name d-none d-md-inline">@User.Identity.Name</span>
                            <i class="bi bi-chevron-down"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end custom-user-menu" aria-labelledby="userDropdown">
                            <li><h6 class="dropdown-header"><i class="bi bi-person-fill me-2"></i>Welcome, @User.Identity.Name!</h6></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                            <li><a class="dropdown-item" href="/Settings"><i class="bi bi-gear me-2"></i>Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="/Account/Login" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Login
                    </a>
                }
            </div>
        </div>
    </nav>
</header>
